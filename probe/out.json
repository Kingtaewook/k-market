  "len": 1682,
  "head": "[{\"total\":1,\"items\":[{\"id\":\"0210002834908\",\"officeId\":\"021\",\"articleId\":\"0002834908\",\"officeName\":\"문화일보\",\"datetime\":\"202611232139\",\"type\":1,\"title\":\"“삼전닉스 이미 손절 늦어…2029년까지 기다려”\",\"body\":\"최근 AI 거품론 등으로 증시가 급락한 가운데 특히 삼성전자 30만 원 이상, SK하이닉스 200만 원 이상에 물린 투자자들은 장기전에 대비해야 한다는 전문가 조언이 나왔다. 이승조 다인인베스트먼트 대표는 최근 유튜브 채널 ‘김작가TV’에 출연해... \",\"photoType\":1,\"imageOriginLink\":\"https://imgnews.pstatic.net/image/origin/021/2026/11/23/2834908.jpg?type=nf220_150\",\"mobileNewsUrl\":\"https://n.news.naver.com/mnews/article/021/0002834908\",\"titleFull\":\"“삼전닉스 이미 손절 늦어…2029년까지 기다려”\"}]},{\"total\":8,\"items\":[{\"id\":\"0310001077687\",\"officeId\":\"031\",\"articleId\":\"0001077687\",\"officeName\":\"아이뉴스24\",\"datetime\":\"202611232124\",\"type\":1,\"title\":\"&quot;반도체 호시절도 내년까지&quot;…삼전닉스 목표가 잇따라 낮춘 IB들\",\"body\":\"글로벌 투자은행(IB)들이 삼성전자와 SK하이닉스의 목표주가를 잇달아 낮췄다. 신규 반도체 공장 가동으로 2028년부터는 공급 확대에 따른 메모리 가격 하락이 나타날 것이라는 전망이다. 23일 금융투자업계에 따르면 골드만삭스는 전일... \",\"photoType\":1,\"imageOriginLink\":\"https://imgnews.pstatic.net/image/origin/031/2026/11/23/1077687.jpg?type=nf220_150\",\"mobileNewsUrl\":\"https://n.news.naver.com/mnews/article/031/0001077687\",\"titleFull\":\"&quot;반도체 호시절도 내년까지&quot;…삼전닉스 목표가 잇따라 낮춘 IB들\"}]},{\"total\":1,\"items\":[{\"id\":\"0320003484571\",\"officeId\":\"032\",\"articleId\":\"0003484571\",\"officeName\":\"경향신문\",\"datetime\":\"202611232123\",\"type\":1,\"title\":\"코스피 4700 턱걸이\",\"body\":\"정부 대책 언급에 ‘블랙 먼데이’ 폭락은 막은 듯 코스피 지수가 23일 미국발 인공지능(AI) 거품론과 금리 인상 가능성에 짓눌려 3% 넘게 하락, 4700대 초반까지 후퇴했다. 증권시장안정펀드(증안펀드) 가동 준비조치가 ‘블랙 먼데이’... \",\"photoType\":1,\"imageOriginLink\":\"https://imgnews.pstatic.net/image/origin/032/2026/11/23/3484571.jpg?type=nf220_150\",\"mobileNewsUrl\":\"https://n.news.naver.com/mnews/article/032/0003484571\",\"titleFull\":\"코스피 4700 턱걸이\"}]}]"
 },
